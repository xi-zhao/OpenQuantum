  "effectReasons": {
    "remote-query": "Read account, backend, calibration or job metadata; no submission or saved-account mutation.",
    "runtime-write": "May submit/cancel a remote job or overwrite/delete credentials outside the workspace.",
    "transpiler-upper-bound": "Account persistence or configurable AI SDK execution; cloud fallback and host cache are not constrained to the workspace. Conservative upper bound.",
    "gym-query": "Read existing server state or perform in-memory circuit/topology operations.",
    "gym-upper-bound": "May mutate shared training/model state, write user-home model/log directories (including lazy mkdir on reads), or manage a background process. Conservative upper bound.",
    "qpanda-query": "Read existing in-memory account, task or binding metadata.",
    "qpanda-upper-bound": "Uses the cloud SDK or mutates shared account/task/binding state without a workspace isolation guarantee. Conservative upper bound.",
    "hardware-workspace": "May create/update the project-local SQLite evidence database, including nested result collection.",
    "hardware-query": "Read provider data or compute a local circuit/math result without job submission or database mutation.",
    "hardware-upper-bound": "May submit/cancel a real job or enter optional SDK/chemistry execution without an isolated read-only guarantee. Conservative upper bound."
  },
