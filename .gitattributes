# Keep repository text deterministic across research environments.
* text=auto

# Harness and validation scripts run in POSIX environments.
*.sh text eol=lf

# Windows launchers retain their native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# The MCP adapter verifies this audited snapshot before exposing its Tools.
src/metriq-data/upstream/snapshot.json -text

# Preserve the audited Flow-VQE source bytes, including upstream whitespace.
.agents/skills/flow-vqe/upstream/* -text whitespace=-blank-at-eol,-blank-at-eof

# Preserve the exact upstream XYZ output and its recorded SHA-256.
docs/integrations/evidence/sdk-ecosystem-2026-10-14/qdk-chemistry/molecule.xyz whitespace=-blank-at-eol

# Keep this evidence cohort's hashed source and lock bytes identical on checkout.
