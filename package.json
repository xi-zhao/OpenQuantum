{
  "name": "openquantum",
  "version": "0.5.1",
  "private": true,
  "description": "A DeepSeek Harness distribution for open quantum research",
  "author": "OpenQuantum contributors",
  "license": "MIT",
  "keywords": [
    "openquantum",
    "quantum-computing",
    "deepseek-harness",
    "scientific-agent",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "learning:ui:setup": "node scripts/setup-openmaic-ui.mjs",
    "dev": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:check": "node --test tests/desktop-integration.test.mjs",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:package:check": "node --test tests/desktop-distribution.test.mjs",
    "desktop:package:smoke": "node scripts/smoke-installed-desktop.mjs",
    "desktop:verify-install": "node scripts/sync-ui-locales.mjs --check --require-desktop && npm run desktop:check && npm run desktop -- --version",
    "harness:dev": "node scripts/run-harness.mjs",
    "harness:config": "node scripts/run-harness.mjs --dump-config",
    "models:probe": "node scripts/probe-models.mjs",
    "mcp:qiskit:probe": "node scripts/probe-qiskit-mcp.mjs",
    "mcp:quantum-hardware:setup": "node scripts/setup-quantum-hardware-mcp.mjs",
    "mcp:qpanda-runtime:setup": "node scripts/setup-qpanda-runtime-mcp.mjs",
    "skill:qpanda:setup": "node scripts/setup-qpanda-skill.mjs",
    "cc-connect:setup": "node scripts/setup-cc-connect.mjs",
    "cc-connect:feishu": "node scripts/setup-cc-connect-platform.mjs feishu",
    "cc-connect:weixin": "node scripts/setup-cc-connect-platform.mjs weixin",
    "cc-connect:yuanbao": "node scripts/setup-cc-connect-platform.mjs yuanbao",
    "cc-connect:start": "node scripts/run-cc-connect.mjs start",
    "cc-connect:web": "node scripts/run-cc-connect.mjs web",
    "cc-connect:status": "node scripts/status-cc-connect.mjs",
    "e2e:qiskit-harness": "node scripts/probe-qiskit-harness.mjs",
    "e2e:quantum-harness": "node scripts/probe-quantum-harness-e2e.mjs",
    "demo:quantum-ground-state": "node scripts/run-quantum-ground-state-demo.mjs",
    "test:harness-web-branding": "node --test tests/harness-web-branding.test.mjs",
    "test:contracts": "node --test .agents/skill-contracts/test/*.test.mjs",
    "capability:conformance": "node scripts/audit-capability-packages.mjs",
    "capability:quantum-practices:test": "node --test tests/quantum-practices.test.mjs tests/harness-quantum-practices.test.mjs",
    "capability:contracts:test": "node scripts/run-capability-contract-checks.mjs",
    "capability:quantum-ground-state:test": "node --test .agents/skills/quantum-ground-state/test/*.test.mjs tests/native-quantum-tools.test.mjs",
    "capability:fieldqkit-hardware:test": "node --test .agents/skills/fieldqkit-hardware/test/*.test.mjs",
    "capability:tyxonq-workbench:test": "node --test .agents/skills/tyxonq-workbench/test/*.test.mjs",
    "capability:fatqat-workbench:test": "node --test .agents/skills/fatqat-workbench/test/*.test.mjs",
    "capability:fatqat-workbench:live": "node --test .agents/skills/fatqat-workbench/test/live.test.mjs",
    "capability:unitary-next:setup": "node scripts/setup-paper-tools.mjs pyzx-optimization graphix-mbqc symmer-tapering paulie-algebra",
    "capability:unitary-next:test": "node --test tests/unitary-next-contracts.test.mjs",
    "capability:unitary-next:live": "OPENQUANTUM_REAL_UNITARY_NEXT=1 node --test --test-concurrency=1 tests/unitary-next-live.test.mjs tests/harness-unitary-next.test.mjs",
    "capability:unitary:setup": "node scripts/setup-paper-tools.mjs dynamiqs-dynamics clifft-sampling oqupy-dynamics deltakit-qec",
    "capability:unitary:test": "node --test tests/unitary-tools-contracts.test.mjs tests/metriq-data.test.mjs",
    "capability:unitary:live": "OPENQUANTUM_REAL_UNITARY_TOOLS=1 node --test --test-concurrency=1 tests/unitary-tools-live.test.mjs tests/harness-unitary-tools.test.mjs",
    "capability:paper-tools:setup": "node scripts/setup-paper-tools.mjs",
    "capability:mitiq:setup": "node scripts/setup-paper-tools.mjs mitiq-error-mitigation",
    "capability:mitiq:test": "node --test tests/mitiq-contracts.test.mjs",
    "capability:mitiq:live": "OPENQUANTUM_REAL_MITIQ=1 node --test --test-concurrency=1 tests/mitiq-live.test.mjs tests/harness-mitiq.test.mjs",
    "capability:paper-tools:test": "node --test tests/paper-tools-contracts.test.mjs",
    "capability:paper-tools:live": "OPENQUANTUM_REAL_PAPER_TOOLS=1 node --test --test-concurrency=1 tests/paper-tools-live.test.mjs tests/harness-paper-tools.test.mjs",
    "capability:qmclaw-workbench:test": "node --test .agents/skills/qmclaw-workbench/test/*.test.mjs tests/native-quantum-tools.test.mjs",
    "capability:qpanda-qubo:test": "node --test .agents/skills/qpanda-qubo/test/*.test.mjs",
    "capability:quantum-information-audit:test": "node --test .agents/skills/quantum-information-audit/test/*.test.mjs",
    "capability:quantum-circuit-verification:test": "node --test .agents/skills/quantum-circuit-verification/test/*.test.mjs",
    "capability:qec-memory-experiment:test": "node --test .agents/skills/qec-memory-experiment/test/*.test.mjs",
    "benchmark:quantum-capabilities:test": "node --test benchmarks/quantum-capabilities/test/*.test.mjs",
    "test:p1": "node --test tests/*.test.mjs && npm run test:contracts && npm run capability:diagnostics:test && npm run capability:quantum-ground-state:test && npm run capability:contracts:test && npm run benchmark:quantum-capabilities:test",
    "capability:diagnostics:test": "node .agents/skills/platform-diagnostics/evals/run-evals.mjs",
    "start": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "lint": "eslint .",
    "locales:check": "node scripts/sync-ui-locales.mjs --check && node --test tests/ui-locales.test.mjs",
    "locales:sync": "node scripts/sync-ui-locales.mjs --write",
    "check": "npm run lint && npm run locales:check && npm run capability:conformance && npm run test:p1 && npm run harness:config",
    "desktop:setup": "node scripts/setup-desktop.mjs",
    "test:quantum-upgrade:live": "node --test tests/quantum-upgrade-live.test.mjs",
    "capability:candidates:setup": "node scripts/setup-paper-tools.mjs qcut-knitting compact-optimization openqarp-excited-states cqlib-kernel flagquantum-workbench",
    "capability:candidates:test": "node --test tests/candidate-tools-contracts.test.mjs tests/flagquantum-contracts.test.mjs",
    "capability:candidates:live": "OPENQUANTUM_REAL_CANDIDATE_TOOLS=1 node --test --test-concurrency=1 tests/candidate-tools-live.test.mjs tests/flagquantum-contracts.test.mjs tests/harness-candidate-tools.test.mjs",
    "benchmark:candidate-regressions": "OPENQUANTUM_REAL_CANDIDATE_TOOLS=1 node --test tests/candidate-upstream-regressions.test.mjs",
    "test:upstream-updates:live": "OPENQUANTUM_REAL_UPSTREAM_UPDATES=1 node --test --test-concurrency=1 tests/upstream-updates-live.test.mjs",
    "capability:interop:setup": "node scripts/setup-paper-tools.mjs clifft-sampling qbraid-conversion",
    "capability:qdmi:setup": "node scripts/setup-qdmi.mjs",
    "capability:interop:test": "node --test tests/interop-contracts.test.mjs",
    "capability:interop:live": "OPENQUANTUM_REAL_INTEROP=1 node --test --test-concurrency=1 tests/interop-live.test.mjs tests/harness-interop.test.mjs",
    "capability:hamiltonian:setup": "node scripts/setup-paper-tools.mjs hamiltonian-simulation",
    "capability:hamiltonian:test": "node --test tests/hamiltonian-contracts.test.mjs",
    "capability:hamiltonian:live": "OPENQUANTUM_REAL_HAMILTONIAN=1 node --test --test-concurrency=1 tests/hamiltonian-live.test.mjs tests/harness-hamiltonian.test.mjs",
    "capability:quantum-practices:catalog": "node scripts/build-quantum-practices-catalog.mjs --check",
    "capability:algorithms:setup": "node scripts/setup-open-algorithm-examples.mjs",
    "capability:algorithms:catalog": "node scripts/build-open-algorithm-skills.mjs --check",
    "capability:algorithms:test": "node --test tests/open-algorithm-skills.test.mjs",
    "capability:algorithms:live": "node scripts/test-open-algorithm-examples.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "@deepseek-ai/dsh-acp": "0.1.5-rc.1",
    "@deepseek-ai/dsh-acp-app": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.1.5-rc.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openmaic/dsl": "0.11.1",
    "@openmaic/generation": "0.3.6",
    "ajv": "8.20.0",
    "cc-connect": "1.5.1-beta.1",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "0.28.2",
    "katex": "0.18.7",
    "pnpm": "11.26.0",
    "sanitize-html": "2.17.7",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@eslint/js": "9.39.5",
    "acorn": "8.18.0",
    "eslint": "9.39.5",
    "globals": "17.12.0"
  },
  "overrides": {
    "pnpm": "11.26.0"
  }
}
