{
  "name": "openquantum",
  "version": "0.4.0",
  "private": true,
  "description": "A DeepSeek Harness distribution for open quantum research",
  "author": "OpenQuantum contributors",
  "license": "MIT",
  "keywords": [
    "openquantum",
    "quantum-computing",
    "deepseek-harness",
    "scientific-agent",
    "mcp"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "desktop": "node scripts/run-desktop.mjs",
    "desktop:check": "node --test tests/desktop-integration.test.mjs",
    "desktop:verify-install": "npm run desktop:check && npm run desktop -- --version",
    "harness:dev": "node scripts/run-harness.mjs",
    "harness:config": "node scripts/run-harness.mjs --dump-config",
    "models:probe": "node scripts/probe-models.mjs",
    "mcp:qiskit:probe": "node scripts/probe-qiskit-mcp.mjs",
    "mcp:quantum-hardware:setup": "node scripts/setup-quantum-hardware-mcp.mjs",
    "mcp:qpanda-runtime:setup": "node scripts/setup-qpanda-runtime-mcp.mjs",
    "skill:qpanda:setup": "node scripts/setup-qpanda-skill.mjs",
    "cc-connect:setup": "node scripts/setup-cc-connect.mjs",
    "cc-connect:feishu": "node scripts/setup-cc-connect-platform.mjs feishu",
    "cc-connect:weixin": "node scripts/setup-cc-connect-platform.mjs weixin",
    "cc-connect:yuanbao": "node scripts/setup-cc-connect-platform.mjs yuanbao",
    "cc-connect:start": "node scripts/run-cc-connect.mjs start",
    "cc-connect:web": "node scripts/run-cc-connect.mjs web",
    "cc-connect:status": "node scripts/status-cc-connect.mjs",
    "e2e:qiskit-harness": "node scripts/probe-qiskit-harness.mjs",
    "e2e:quantum-harness": "node scripts/probe-quantum-harness-e2e.mjs",
    "demo:quantum-ground-state": "node scripts/run-quantum-ground-state-demo.mjs",
    "test:harness-web-branding": "node --test tests/harness-web-branding.test.mjs",
    "test:contracts": "node --test .agents/skill-contracts/test/*.test.mjs",
    "capability:conformance": "node scripts/audit-capability-packages.mjs",
    "capability:quantum-ground-state:test": "node --test .agents/skills/quantum-ground-state/test/*.test.mjs",
    "capability:fieldqkit-hardware:test": "node --test .agents/skills/fieldqkit-hardware/test/*.test.mjs",
    "capability:tyxonq-workbench:test": "node --test .agents/skills/tyxonq-workbench/test/*.test.mjs",
    "capability:qpanda-qubo:test": "node --test .agents/skills/qpanda-qubo/test/*.test.mjs",
    "capability:quantum-information-audit:test": "node --test .agents/skills/quantum-information-audit/test/*.test.mjs",
    "capability:quantum-circuit-verification:test": "node --test .agents/skills/quantum-circuit-verification/test/*.test.mjs",
    "capability:qec-memory-experiment:test": "node --test .agents/skills/qec-memory-experiment/test/*.test.mjs",
    "benchmark:quantum-capabilities:test": "node --test benchmarks/quantum-capabilities/test/*.test.mjs",
    "test:p1": "node --test tests/*.test.mjs && npm run test:contracts && npm run capability:diagnostics:test && npm run capability:quantum-ground-state:test && npm run capability:fieldqkit-hardware:test && npm run capability:tyxonq-workbench:test && npm run capability:qpanda-qubo:test && npm run capability:quantum-information-audit:test && npm run capability:quantum-circuit-verification:test && npm run capability:qec-memory-experiment:test && npm run benchmark:quantum-capabilities:test",
    "capability:diagnostics:test": "node .agents/skills/platform-diagnostics/evals/run-evals.mjs",
    "start": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "lint": "eslint .",
    "check": "npm run lint && npm run capability:conformance && npm run test:p1 && npm run harness:config"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-acp-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.18.0",
    "cc-connect": "1.5.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@eslint/js": "9.39.4",
    "dsh-plugin-desktop": "2.0.0",
    "electron": "43.4.0",
    "eslint": "^9",
    "globals": "14.0.0"
  },
  "overrides": {
    "pnpm": "11.8.0"
  }
}
