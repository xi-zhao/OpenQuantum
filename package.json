{
  "name": "openquantum",
  "version": "0.4.0",
  "private": true,
  "description": "An open research agent for quantum computing and scientific exploration",
  "author": "openquantum",
  "license": "MIT",
  "keywords": [
    "openquantum",
    "quantum-computing",
    "scientific-agent",
    "nextjs",
    "ai"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "dev:stack": "node scripts/run-dev-stack.mjs",
    "dev:legacy-ui": "next dev --port 3001 --hostname 127.0.0.1",
    "gateway:dev": "node scripts/run-gateway.mjs",
    "harness:dev": "node scripts/run-harness.mjs",
    "harness:config": "node scripts/run-harness.mjs --dump-config",
    "models:probe": "node scripts/probe-models.mjs",
    "mcp:qiskit:probe": "node scripts/probe-qiskit-mcp.mjs",
    "mcp:quantum-hardware:setup": "node scripts/setup-quantum-hardware-mcp.mjs",
    "e2e:qiskit-harness": "node scripts/probe-qiskit-harness.mjs",
    "e2e:quantum-harness": "node scripts/probe-quantum-harness-e2e.mjs",
    "demo:quantum-ground-state": "node scripts/run-quantum-ground-state-demo.mjs",
    "test:gateway": "node --test tests/openquantum-gateway.test.mjs",
    "test:harness-web-branding": "node --test tests/harness-web-branding.test.mjs",
    "test:harness-bff": "tsx --test tests/harness-bff.test.mjs",
    "test:harness-contract": "tsx --test tests/harness-ui-port.test.mjs",
    "test:harness-events": "tsx --test tests/harness-events.test.mjs",
    "test:harness-respond": "tsx --test tests/harness-respond.test.mjs",
    "test:contracts": "node --test .agents/skill-contracts/test/*.test.mjs",
    "capability:quantum-ground-state:test": "node --test .agents/skills/quantum-ground-state/test/*.test.mjs",
    "capability:fieldqkit-hardware:test": "node --test .agents/skills/fieldqkit-hardware/test/*.test.mjs",
    "test:p1": "tsx --test tests/*.test.mjs && npm run test:contracts && npm run capability:diagnostics:test && npm run capability:quantum-ground-state:test && npm run capability:fieldqkit-hardware:test",
    "capability:diagnostics:test": "node .agents/skills/platform-diagnostics/evals/run-evals.mjs",
    "build": "next build",
    "start": "node scripts/run-harness.mjs --port 3000 --trusted-host localhost:3000",
    "start:legacy-ui": "next start --port 3001 --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:p1 && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.6",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "http-proxy": "1.18.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "1.17.17",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5"
  }
}
