    {
      "name": "synthesize_permutation_tool",
      "description": "Synthesize an optimal quantum circuit for a qubit permutation.\n\nUses a trained PermutationGym model to find an optimal SWAP gate sequence\nthat implements the desired qubit permutation on the coupling map.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "ID of a loaded PermutationGym model"
          },
          "permutation": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "description": "Target permutation as list of qubit indices.\nExample: [2, 0, 1] means qubit 0 -> position 2, qubit 1 -> position 0"
          },
          "num_searches": {
            "default": 1000,
            "type": "integer",
            "description": "Number of search attempts. Higher = better results. Max: 10000"
          },
          "deterministic": {
            "default": false,
            "type": "boolean",
            "description": "If True, use deterministic action selection"
          }
        },
        "required": [
          "model_id",
          "permutation"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "synthesize_linear_function_tool",
      "description": "Synthesize an optimal quantum circuit for a linear Boolean function.\n\nUses a trained LinearFunctionGym model to find an optimal CNOT circuit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "ID of a loaded LinearFunctionGym model"
          },
          "linear_function": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "description": "NxN binary matrix representing the linear function.\nEntry [i][j]=1 means output i depends on input j (XOR)."
          },
          "num_searches": {
            "default": 1000,
            "type": "integer",
            "description": "Number of search attempts. Max: 10000"
          },
          "deterministic": {
            "default": false,
            "type": "boolean",
            "description": "If True, use deterministic action selection"
          }
        },
        "required": [
          "model_id",
          "linear_function"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "synthesize_clifford_tool",
      "description": "Synthesize an optimal quantum circuit for a Clifford operation.\n\nUses a trained CliffordGym model to find an optimal Clifford implementation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "description": "ID of a loaded CliffordGym model"
          },
          "clifford_tableau": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "additionalProperties": true,
                "type": "object"
              }
            ],
            "description": "Clifford tableau in standard (2N+1 x 2N) format,\nor dict with \"destab\" and \"stab\" matrices."
          },
          "num_searches": {
            "default": 1000,
            "type": "integer",
            "description": "Number of search attempts. Max: 10000"
          },
          "deterministic": {
            "default": false,
            "type": "boolean",
            "description": "If True, use deterministic action selection"
          }
        },
        "required": [
          "model_id",
          "clifford_tableau"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
