    {
      "name": "start_training_tool",
      "description": "Start training an RL agent on a created environment.\n\nThis initiates training that learns to synthesize optimal circuits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "env_id": {
            "type": "string",
            "description": "Environment ID from create_*_env_tool"
          },
          "algorithm": {
            "default": "ppo",
            "enum": [
              "ppo",
              "alphazero"
            ],
            "type": "string",
            "description": "RL algorithm to use:\n- \"ppo\": Proximal Policy Optimization (recommended, faster)\n- \"alphazero\": AlphaZero-style MCTS (better for complex problems)"
          },
          "policy": {
            "default": "basic",
            "enum": [
              "basic",
              "conv1d"
            ],
            "type": "string",
            "description": "Neural network policy architecture:\n- \"basic\": Simple feedforward network (faster, good for small problems)\n- \"conv1d\": 1D convolutional network (better for larger problems)"
          },
          "num_iterations": {
            "default": 100,
            "type": "integer",
            "description": "Number of training iterations. Default: 100"
          },
          "tensorboard_experiment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Name for TensorBoard logging (optional)"
          },
          "background": {
            "default": false,
            "type": "boolean",
            "description": "If True, run training in background and return immediately.\nUse get_training_status_tool to poll progress, or wait_for_training_tool\nto block until done. Default: False (synchronous)."
          }
        },
        "required": [
          "env_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "batch_train_environments_tool",
      "description": "Train multiple environments in sequence.\n\nUseful for training models across multiple topologies or subtopologies\nextracted from hardware.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "env_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "description": "List of environment IDs to train"
          },
          "algorithm": {
            "default": "ppo",
            "enum": [
              "ppo",
              "alphazero"
            ],
            "type": "string",
            "description": "RL algorithm to use"
          },
          "policy": {
            "default": "basic",
            "enum": [
              "basic",
              "conv1d"
            ],
            "type": "string",
            "description": "Neural network policy architecture"
          },
          "num_iterations": {
            "default": 100,
            "type": "integer",
            "description": "Number of iterations per environment"
          },
          "tensorboard_prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Prefix for TensorBoard experiment names"
          },
          "background": {
            "default": false,
            "type": "boolean",
            "description": "If True, start all training in background and return immediately.\nUse get_training_status_tool or wait_for_training_tool to monitor."
          }
        },
        "required": [
          "env_ids"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
