{
  "schemaVersion": 1,
  "server": "qiskit_gym",
  "tools": [
    {
      "name": "create_permutation_env_tool",
      "description": "Create a PermutationGym environment for learning qubit routing with SWAP gates.\n\nUse this to create an RL environment that learns to implement arbitrary qubit\npermutations using minimal SWAP gates on constrained coupling maps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "coupling_map": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Custom coupling map as list of [qubit1, qubit2] edges.\nExample: [[0,1], [1,2], [2,3]] for a linear chain."
          },
          "preset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hardware preset name (use instead of coupling_map).\nOptions: \"ibm_heron_r1\", \"ibm_heron_r2\", \"ibm_nighthawk\",\n        \"grid_3x3\", \"grid_5x5\", \"linear_5\", \"linear_10\""
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "create_linear_function_env_tool",
      "description": "Create a LinearFunctionGym environment for learning CNOT synthesis.\n\nThe environment learns to decompose linear Boolean functions into efficient\nquantum circuits using CNOT gates.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "coupling_map": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Custom coupling map as list of [qubit1, qubit2] edges."
          },
          "preset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hardware preset name (e.g., \"ibm_nighthawk\", \"grid_3x3\")"
          },
          "basis_gates": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional list of basis gates (default: [\"cx\"])"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "create_clifford_env_tool",
      "description": "Create a CliffordGym environment for learning Clifford circuit synthesis.\n\nThe environment learns to synthesize optimal implementations of Clifford\ngroup elements using a customizable gate set.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "num_qubits": {
            "type": "integer",
            "description": "Number of qubits for the environment"
          },
          "coupling_map": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "integer"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Custom coupling map (optional)"
          },
          "preset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Hardware preset name (optional)"
          },
          "gateset": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "additionalProperties": true,
                      "type": "object"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Custom gate set. Can be:\n- List of gate names: [\"H\", \"S\", \"CX\"] (applied to all qubits/edges)\n- List of dicts: [{\"gate\": \"H\", \"qubits\": [0]}, {\"gate\": \"CX\", \"qubits\": [0, 1]}]"
          }
        },
        "required": [
          "num_qubits"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
