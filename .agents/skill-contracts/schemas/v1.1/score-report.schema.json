{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquantum.local/contracts/v1.1/score-report.schema.json",
  "title": "OpenQuantum Score Report v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "capability",
    "generatedAt",
    "resultPackages",
    "profile",
    "evaluationSuite",
    "runner",
    "status",
    "scope",
    "cases",
    "earnedWeight",
    "totalWeight",
    "limitations",
    "statement"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "reportId": { "$ref": "#/$defs/id" },
    "capability": { "$ref": "#/$defs/versionedRef" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "resultPackages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packageRef" }
    },
    "profile": { "$ref": "#/$defs/versionedShaRef" },
    "evaluationSuite": { "$ref": "#/$defs/versionedShaRef" },
    "runner": { "$ref": "#/$defs/runnerRef" },
    "status": { "enum": ["invalid", "valid"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceRefs", "statement"],
      "properties": {
        "status": { "enum": ["in_scope", "out_of_scope", "indeterminate"] },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "statement": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["in_scope", "out_of_scope"] }
            }
          },
          "then": {
            "properties": {
              "evidenceRefs": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "weight",
          "hardGate",
          "expectedOutcome",
          "evidenceRefs"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "outcome": { "enum": ["pass", "fail"] },
          "weight": { "type": "number", "minimum": 0 },
          "hardGate": { "type": "boolean" },
          "expectedOutcome": {},
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidenceRef" }
          },
          "observed": {},
          "failure": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "outcome": { "const": "fail" } }
            },
            "then": {
              "properties": {
                "failure": { "type": "string", "minLength": 1 }
              },
              "required": ["failure"]
            },
            "else": { "properties": { "failure": false } }
          }
        ]
      }
    },
    "earnedWeight": { "type": "number", "minimum": 0 },
    "totalWeight": { "type": "number", "exclusiveMinimum": 0 },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "metric", "unit"],
      "properties": {
        "value": { "type": "number" },
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "statement": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "invalid" } } },
      "then": { "properties": { "score": false } },
      "else": { "properties": { "score": true }, "required": ["score"] }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$",
      "maxLength": 160
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "versionedShaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runnerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "sha256"],
      "properties": {
        "packageId": { "$ref": "#/$defs/id" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageId", "kind", "id"],
          "properties": {
            "packageId": { "$ref": "#/$defs/id" },
            "kind": { "const": "input" },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageId", "kind", "id"],
          "properties": {
            "packageId": { "$ref": "#/$defs/id" },
            "kind": { "const": "artifact" },
            "id": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageId", "kind", "id", "sequence"],
          "properties": {
            "packageId": { "$ref": "#/$defs/id" },
            "kind": { "const": "session-event" },
            "id": { "type": "string", "minLength": 1 },
            "sequence": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    }
  }
}
