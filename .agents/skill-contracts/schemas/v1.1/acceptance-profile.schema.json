{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquantum.local/contracts/v1.1/acceptance-profile.schema.json",
  "title": "OpenQuantum Acceptance Profile v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "scope", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "scope": { "$ref": "#/$defs/scope" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedClaims", "outOfScope"],
      "properties": {
        "supportedClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "required", "criterion"],
      "dependentRequired": { "threshold": ["unit"] },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "criterion": { "type": "string", "minLength": 1 },
        "threshold": {},
        "unit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
