{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "numQubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 2
    },
    "generators": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[IXYZ]+$",
        "minLength": 1
      },
      "minItems": 1,
      "default": [
        "XI",
        "ZI",
        "IX",
        "IZ",
        "ZZ"
      ]
    },
    "closureMode": {
      "enum": [
        "auto",
        "full",
        "skip"
      ],
      "default": "auto"
    },
    "referenceMode": {
      "type": "string",
      "enum": [
        "auto",
        "required",
        "skip"
      ],
      "default": "auto",
      "description": "auto computes the reference for default small-system cases; required attempts it at the requested size using the user's resources; skip omits it. A failed reference is an error, never a successful skip."
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "required": [],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Worker deadline; 0 disables it. Omitted inherits the deployment setting."
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Combined stdout/stderr budget; 0 disables it. Omitted inherits the deployment setting."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Thread count for supported numerical kernels. Omitted preserves the user's environment and library defaults."
        }
      }
    }
  },
  "required": [
    "numQubits",
    "generators",
    "closureMode",
    "referenceMode"
  ],
  "additionalProperties": false
}
