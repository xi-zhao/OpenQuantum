{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reducedQubits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sectorDimension": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      ]
    },
    "reducedTerms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pauli": {
            "type": "string",
            "pattern": "^[IXYZ]*$"
          },
          "coefficient": {
            "type": "number"
          }
        },
        "required": [
          "pauli",
          "coefficient"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reducedSpectrum": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "referenceSectorSpectrum": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "maxSpectrumError": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "projectorIdempotenceError": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "bitOrder": {
      "const": "left-to-right tensor factors; reduced qubits use Symmer's transformed basis"
    },
    "reference": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "skip"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "computed",
            "not_run"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "mode",
        "status",
        "method",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reducedQubits",
    "sectorDimension",
    "reducedTerms",
    "reducedSpectrum",
    "referenceSectorSpectrum",
    "maxSpectrumError",
    "projectorIdempotenceError",
    "bitOrder",
    "reference"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "computed"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reducedSpectrum": {
            "not": {
              "type": "null"
            }
          },
          "referenceSectorSpectrum": {
            "not": {
              "type": "null"
            }
          },
          "maxSpectrumError": {
            "not": {
              "type": "null"
            }
          },
          "projectorIdempotenceError": {
            "not": {
              "type": "null"
            }
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "reducedSpectrum": {
            "type": "null"
          },
          "referenceSectorSpectrum": {
            "type": "null"
          },
          "maxSpectrumError": {
            "type": "null"
          },
          "projectorIdempotenceError": {
            "type": "null"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "mode": {
                "const": "required"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "computed"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "mode": {
                "const": "skip"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
