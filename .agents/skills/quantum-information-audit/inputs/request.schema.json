{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquantum.local/capabilities/quantum-information-audit/request.schema.json",
  "title": " density-matrix audit request",
  "type": "object",
  "additionalProperties": false,
  "required": ["matrixReal", "subsystemDimensions", "transposeSubsystems"],
  "properties": {
    "matrixReal": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "items": { "type": "number" }
      }
    },
    "matrixImag": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "items": { "type": "number" }
      }
    },
    "subsystemDimensions": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "integer", "minimum": 2 }
    },
    "transposeSubsystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
