{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_checked"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
