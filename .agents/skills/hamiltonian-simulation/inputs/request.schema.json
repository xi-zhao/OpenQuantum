{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "numQubits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pauli": {
            "type": "string",
            "pattern": "^[IXYZ]+$"
          },
          "coefficient": {
            "type": "number",
            "minimum": -1.7976931348623157e+308,
            "maximum": 1.7976931348623157e+308
          }
        },
        "required": [
          "pauli",
          "coefficient"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "time": {
      "type": "number",
      "minimum": -1.7976931348623157e+308,
      "maximum": 1.7976931348623157e+308
    },
    "method": {
      "enum": [
        "trotter",
        "qdrift"
      ],
      "default": "trotter"
    },
    "steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 32,
      "description": "Exact number of Trotter slices or qDrift sampled Pauli rotations; not an error guarantee."
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Trotter only: 1 or an even order; defaults to 2."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "qDrift only: reproducible NumPy PCG64 seed; defaults to 0."
    },
    "outputMode": {
      "enum": [
        "statevector",
        "circuit"
      ],
      "default": "statevector"
    },
    "initialState": {
      "anyOf": [
        {
          "enum": [
            "zero",
            "plus"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -1.7976931348623157e+308,
              "maximum": 1.7976931348623157e+308
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 1
        }
      ],
      "default": "zero"
    },
    "referenceMode": {
      "type": "string",
      "enum": [
        "auto",
        "required",
        "skip"
      ],
      "default": "auto",
      "description": "auto computes the reference for default small-system cases; required attempts it at the requested size using the user's resources; skip omits it. A failed reference is an error, never a successful skip."
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "required": [],
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Worker deadline; 0 disables it. Omitted inherits the deployment setting."
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Combined stdout/stderr budget; 0 disables it. Omitted inherits the deployment setting."
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Thread count for supported numerical kernels. Omitted preserves the user's environment and library defaults."
        }
      }
    }
  },
  "required": [
    "numQubits",
    "terms",
    "time"
  ],
  "additionalProperties": false
}
