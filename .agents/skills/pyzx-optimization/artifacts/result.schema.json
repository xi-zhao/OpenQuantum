{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "inputQasm": {
      "type": "string",
      "minLength": 1
    },
    "optimizedQasm": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": "object",
      "properties": {
        "gates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "twoQubitGates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gates",
        "twoQubitGates",
        "tCount",
        "depth"
      ],
      "additionalProperties": false
    },
    "after": {
      "type": "object",
      "properties": {
        "gates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "twoQubitGates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "gates",
        "twoQubitGates",
        "tCount",
        "depth"
      ],
      "additionalProperties": false
    },
    "unitaryMaxError": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "equivalenceTolerance": {
      "anyOf": [
        {
          "const": 1e-8
        },
        {
          "type": "null"
        }
      ]
    },
    "equivalentUpToGlobalPhase": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "bitOrder": {
      "const": "left-to-right q0,q1,..."
    },
    "reference": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "required",
            "skip"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "computed",
            "not_run"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      },
      "required": [
        "mode",
        "status",
        "method",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "inputQasm",
    "optimizedQasm",
    "before",
    "after",
    "unitaryMaxError",
    "equivalenceTolerance",
    "equivalentUpToGlobalPhase",
    "bitOrder",
    "reference"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "computed"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "unitaryMaxError": {
            "not": {
              "type": "null"
            }
          },
          "equivalenceTolerance": {
            "not": {
              "type": "null"
            }
          },
          "equivalentUpToGlobalPhase": {
            "not": {
              "type": "null"
            }
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "unitaryMaxError": {
            "type": "null"
          },
          "equivalenceTolerance": {
            "type": "null"
          },
          "equivalentUpToGlobalPhase": {
            "type": "null"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "mode": {
                "const": "required"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "computed"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "reference": {
            "properties": {
              "mode": {
                "const": "skip"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reference": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
