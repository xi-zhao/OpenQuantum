{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openquantum.local/schemas/quantum-ground-state/request-v1.json",
  "title": "Quantum Ground State Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "claim",
    "system",
    "hamiltonian",
    "method",
    "acceptanceProfile"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "$ref": "#/$defs/id" },
    "claim": { "const": "sector-ground-energy-of-supplied-hamiltonian" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "source"],
      "properties": {
        "kind": { "const": "qubit-model" },
        "label": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "supplied-pauli-sum" }
          }
        }
      }
    },
    "hamiltonian": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "qubitCount",
        "qubitOrder",
        "basisOrder",
        "coefficientUnit",
        "sector",
        "terms"
      ],
      "properties": {
        "format": { "const": "openquantum-pauli-sum-v1" },
        "qubitCount": { "const": 2 },
        "qubitOrder": { "const": "left-to-right-msb" },
        "basisOrder": { "const": "00-01-10-11" },
        "coefficientUnit": { "const": "hartree" },
        "sector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed-hamming-weight" },
            "value": { "const": 1 }
          }
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pauli", "coefficient"],
            "properties": {
              "pauli": { "type": "string", "pattern": "^[IXZ]{2}$" },
              "coefficient": {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              }
            }
          }
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "simulator", "ansatz", "optimizer", "randomness"],
      "properties": {
        "algorithm": { "const": "vqe" },
        "simulator": { "const": "statevector" },
        "ansatz": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "const": "two-qubit-single-excitation-givens" },
            "version": { "const": "1.0.0" }
          }
        },
        "optimizer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "coarsePoints",
            "angleToleranceRadians",
            "maxEvaluations"
          ],
          "properties": {
            "id": { "const": "coarse-grid-golden-refine" },
            "version": { "const": "1.0.0" },
            "coarsePoints": { "const": 65 },
            "angleToleranceRadians": {
              "type": "number",
              "minimum": 1e-14,
              "maximum": 0.01
            },
            "maxEvaluations": {
              "type": "integer",
              "minimum": 8,
              "maximum": 256
            }
          }
        },
        "randomness": { "const": "none" }
      }
    },
    "acceptanceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "supplied-pauli-statevector" },
        "version": { "const": "1.0.0" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$",
      "maxLength": 160
    }
  }
}
