# Copy this file to .env and fill only the local values you need.
# Never commit .env or real credentials.

# The built-in model routes use OpenAI-compatible Chat Completions.
#
# The BASE_URL values below are placeholders, not defaults that work: .invalid
# is reserved by RFC 2606 and never resolves. Replace them with your own
# endpoint before using these environment-based routes.
#
# The built-in model ids live in
# runtime/openquantum/model-routes.cordis.yml (kimi-k2.7-code, glm5.2,
# kimi2.7) and are not overridable from here -- if your endpoint serves other
# names, set them in the Settings Center instead.
#
# Choose a model that supports tool calling, and verify actual Tool inputs and
# results in the workbench. Text responses alone do not verify tool use.
#
# This optional probe reads these environment variables and uses the fixed
# model ids in scripts/probe-models.mjs; it does not read Settings Center route
# overrides. Use it only when your endpoint serves those model ids:
#   npm run models:probe -- --provider openquantum-public
OPENQUANTUM_PUBLIC_API_KEY=
OPENQUANTUM_PUBLIC_BASE_URL=https://api.example.invalid/v1

OPENQUANTUM_PRIVATE_API_KEY=
OPENQUANTUM_PRIVATE_BASE_URL=https://private-api.example.invalid/v1

# Prefer the UI Settings Center, which stores this in the Harness credential
# store. Deployment environments may provide the same reference directly.
QISKIT_IBM_TOKEN=
